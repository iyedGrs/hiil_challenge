# Environment contract for the local demo - spec/local-dev.md L3.
# Copy to .env and fill in local values:  cp .env.example .env
#
# .env is git-ignored and personal. Never put real case data, real party details
# or a provider API key in it, in fixtures, in screenshots or in source control.
# This file is committed, so it must only ever hold nonsecret defaults.

# --- Application ---
APP_ENV=development
# Browser origin allowed by CORS / cookie policy (the Vite dev server).
APP_ORIGIN=http://localhost:5173
# Local HTTP exception only. Use true wherever the app is served over HTTPS.
COOKIE_SECURE=false
# Signs session cookies. Generate your own, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-generate-a-random-value

# --- Database (host `db` is the Compose service name) ---
POSTGRES_DB=dispute_demo
POSTGRES_USER=dispute_demo
# Generate a local value and use the SAME value inside DATABASE_URL below.
POSTGRES_PASSWORD=change-me-generate-a-random-value
DATABASE_URL=postgresql+psycopg://dispute_demo:change-me-generate-a-random-value@db:5432/dispute_demo

# --- Private file storage (mounted volume shared by api and worker) ---
FILE_STORAGE_ROOT=/data/private

# --- AI mode and cost controls ---
# fixture = deterministic local fixtures, zero provider calls (default).
# live    = real provider; requires AI_PROVIDER, AI_MODEL, AI_API_KEY and a
#           positive AI_DEMO_BUDGET_USD, and must fail startup validation if any
#           is missing. A live failure never falls back to fixture answers.
AI_MODE=fixture
AI_DEMO_BUDGET_USD=0
AI_MAX_CONCURRENCY=1
# Left unset in fixture mode so nothing looks configured that is not. Uncomment
# and fill in only when deliberately switching to live mode; these values stay
# server-side and are never exposed to the frontend.
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=
# AI_ENDPOINT=

# --- Legal pack and case limits (spec/backend.md B4, B5) ---
LEGAL_PACK_VERSION=tn-goods-v1
MAX_CASE_FILES=10
MAX_CASE_PAGES=30
# 10 MiB per file, 50 MiB per case.
MAX_FILE_BYTES=10485760
MAX_CASE_BYTES=52428800

# --- OCR ---
OCR_LANGUAGES=fra+ara+eng

# --- Frontend / Vite dev server (nonsecret) ---
# In Compose the proxy target is the api service; use http://127.0.0.1:8000 when
# Vite runs directly on the host.
API_PROXY_TARGET=http://api:8000
# fixture = browser fixtures only, http = call the real API.
VITE_DATA_MODE=fixture
