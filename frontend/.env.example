# Frontend-only environment (UI-owned). Copy to .env.development for local
# dev-server overrides (NOT plain .env: Vite loads .env in every mode
# including vitest's "test" mode, which would silently switch unit tests from
# the fixture adapter to the HTTP adapter; .env.development only applies to
# `vite`/`vite build`, not `vitest`).

# "fixture" (default) uses the in-memory seeded adapter; "http" talks to the
# real backend at relative /api. Any other value fails at startup (see
# src/api/index.ts) rather than silently falling back.
VITE_DATA_MODE=fixture

# Where the Vite dev server proxies /api requests to (read by vite.config.ts
# via loadEnv; only used with VITE_DATA_MODE=http). Not exposed to the
# browser bundle — deliberately unprefixed with VITE_.
# Host default: http://127.0.0.1:8000 (matches root .env.example outside Compose).
API_PROXY_TARGET=http://127.0.0.1:8000
